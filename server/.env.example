PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Set GITHUB_TOKEN on the backend service in production; restart after changes.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_HOURS=24

# For production frontend builds, set VITE_API_URL to the backend origin
# (for example, https://api.example.com; do not include /api).
# Set CORS_ORIGIN above to the frontend's origin in production.

RESUME_CACHE_TTL_HOURS=168
ENRICH_CONCURRENCY=4

# Optional: without a key, resume parsing stays rule-based
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_MODE=auto
LLM_MIN_INTERVAL_MS=4000
LLM_CONCURRENCY=2
LLM_CACHE_TTL_HOURS=168