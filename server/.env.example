PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Optional: without a token, GitHub data comes from a mock enricher
GITHUB_TOKEN=
GITHUB_CACHE_TTL_HOURS=24

RESUME_CACHE_TTL_HOURS=168
ENRICH_CONCURRENCY=4

# Optional: without a key, resume parsing stays rule-based
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
LLM_MODE=auto
LLM_MIN_INTERVAL_MS=4000
LLM_CONCURRENCY=2
LLM_CACHE_TTL_HOURS=168